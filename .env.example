# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Google Cloud ──────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=bigquery-public-data.thelook_ecommerce

# ── Supabase — pooled connection (ingestion + Python analysis) ────
# Port 6543 via PgBouncer — high-throughput bulk inserts
DW_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DW_PORT=6543
DW_DATABASE=postgres
DW_USER=postgres.your_project_ref
DW_PASSWORD=your-supabase-db-password

# ── Supabase — direct connection (dbt only) ───────────────────────
# Port 5432 — required for dbt prepared statements
DBT_HOST=db.your_project_ref.supabase.co
DBT_PORT=5432
DBT_DATABASE=postgres
DBT_USER=postgres.your_project_ref
DBT_PASSWORD=your-supabase-db-password

# ── Notifications (optional) ──────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
